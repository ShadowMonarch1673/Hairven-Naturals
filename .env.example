# Copy to .env and fill in real values. Never commit .env.
DEBUG=True
SECRET_KEY=generate-with-get_random_secret_key
# True = print emails in the terminal instead of sending (use on networks that block SMTP)
USE_CONSOLE_EMAIL=True
BREVO_USERNAME=
BREVO_PASSWORD=
DEFAULT_FROM_EMAIL=Hairven Naturals <orders@yourdomain.com>
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...
# Redirect flow only: frontend page Paystack returns the customer to
PAYSTACK_CALLBACK_URL=
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173